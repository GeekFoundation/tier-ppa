#!/bin/sh
set -e

# #DEBHELPER# expands to the debhelper-generated snippets, including the
# dh_installsystemd daemon-reload + enable (no start) for tierd.service.
#DEBHELPER#

if [ "$1" = "configure" ] && [ -z "$2" ]; then
    # Fresh install: enabled for boot by dh_installsystemd, but not started —
    # the operator reviews the node config first.
    echo "tierd: edit /etc/tier/tierd.toml (roles, network, seeds), then: systemctl start tierd" >&2
fi

if [ "$1" = "configure" ] && [ -n "$2" ]; then
    # Upgrade ($2 is the version being replaced): pick up the new binary.
    # dh_installsystemd runs with --no-start, which suppresses the restart after
    # an upgrade as well, so without this an unattended-upgrade would leave the
    # old binary running until someone restarted it by hand. try-restart is a
    # no-op on an inactive unit, so a node the operator deliberately stopped
    # stays stopped.
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke try-restart tierd.service >/dev/null 2>&1 || true
    fi
fi

exit 0
