#!/bin/sh
set -e

# The debhelper token below expands to the generated snippets, including the
# dh_installsystemd daemon-reload + enable (no start) for tierd.service. Keep
# the token out of comments: dh_installdeb substitutes it textually anywhere in
# the file, so a mention inside a comment is replaced too and breaks the script.
#DEBHELPER#

if [ "$1" = "configure" ] && [ -z "$2" ]; then
    # Fresh install: enabled for boot by dh_installsystemd, but not started —
    # the operator reviews the node config first.
    echo "tierd: edit /etc/tier/tierd.toml (roles, network, seeds), then: systemctl start tierd" >&2
fi

if [ "$1" = "configure" ] && [ -n "$2" ]; then
    # Upgrade ($2 is the version being replaced): bring the daemon back on the
    # new binary, but only if it was running before the upgrade. The flag is
    # written by debian/tierd.preinst, because dh_installsystemd --no-start
    # stops the unit in preinst and emits no start of its own; without this an
    # unattended-upgrade would silently leave the node down. restart is correct
    # whether the unit is still active or already stopped, and a node the
    # operator deliberately stopped has no flag and stays stopped.
    if [ -e /run/tierd.was-active ]; then
        rm -f /run/tierd.was-active
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke restart tierd.service >/dev/null || true
        fi
    fi
fi

exit 0
